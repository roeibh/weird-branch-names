#!/bin/bash

# Colors for beautiful output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Function to print colored log messages
log_info() {
    echo -e "${BLUE}ℹ️  INFO:${NC} $1"
}

log_success() {
    echo -e "${GREEN}✅ SUCCESS:${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}⚠️  WARNING:${NC} $1"
}

log_error() {
    echo -e "${RED}❌ ERROR:${NC} $1"
}

log_step() {
    echo -e "${PURPLE}🔧 STEP:${NC} $1"
}

log_separator() {
    echo -e "${CYAN}════════════════════════════════════════════════════════════════${NC}"
}

# Function to handle errors and exit
handle_error() {
    log_error "$1"
    log_error "Script execution failed."
    log_separator
    exit 1
}

# Main script starts here
log_separator
echo -e "${CYAN}🚀 Invalid Branch Creation Script (Remote-Only)${NC}"
log_separator

# Check if branch name is provided
if [ $# -eq 0 ]; then
    log_error "Branch name is required!"
    echo -e "${YELLOW}Usage: ./create-invalid-branch <branch-name>${NC}"
    echo -e "${CYAN}Note: This script creates branches that exist only remotely and cannot be checked out locally.${NC}"
    exit 1
fi

branch_name="$1"
log_info "Starting remote-only branch creation for: ${CYAN}'$branch_name'${NC}"
log_warning "This branch will exist remotely but cannot be checked out locally!"

# Check if we're in a git repository
log_step "Verifying we're in a Git repository..."
if ! git rev-parse --git-dir &>/dev/null; then
    handle_error "Not in a Git repository. Please run this script from within a Git repository."
fi
log_success "Git repository detected"

# Check if main branch exists and switch to it
log_step "Ensuring we're on the main branch..."
if ! git show-ref --verify --quiet refs/heads/main; then
    handle_error "Main branch does not exist. Please ensure you have a 'main' branch."
fi

current_branch=$(git branch --show-current)
if [[ "$current_branch" != "main" ]]; then
    log_info "Currently on branch '$current_branch', switching to main..."
    if ! git checkout main; then
        handle_error "Failed to switch to main branch. Please ensure your working directory is clean."
    fi
fi
log_success "On main branch"

# Pull latest changes from origin/main
log_step "Pulling latest changes from origin/main..."
if git pull origin main; then
    log_success "Successfully pulled latest changes from origin/main"
else
    log_warning "Failed to pull from origin/main. Continuing with local main branch..."
fi

# Check if branch exists on remote
log_step "Checking if branch '$branch_name' already exists on remote..."
if git ls-remote --exit-code --heads origin "$branch_name" &>/dev/null; then
    handle_error "Branch '$branch_name' already exists on remote. Please choose a different name."
fi
log_success "Branch name '$branch_name' is available on remote"

# Test if branch name would be locally invalid
log_step "Testing if branch name would be locally invalid..."
if git check-ref-format --branch "$branch_name" &>/dev/null; then
    log_warning "Branch name '$branch_name' is actually VALID locally. Consider using the regular create-branch script instead."
    echo -e "${YELLOW}Do you want to continue anyway? [y/N]${NC}"
    read -r response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        log_info "Aborting. Use ./create-branch for valid branch names."
        exit 0
    fi
else
    log_success "Confirmed: '$branch_name' is locally invalid (perfect for this script!)"
fi

# Update README.md content
log_step "Updating README.md content..."
readme_content="This is remote-only branch: $branch_name

⚠️  WARNING: This branch was created using refspec push and cannot be checked out locally!

Branch characteristics:
- Created from: main
- Method: git push origin HEAD:$branch_name
- Local checkout: IMPOSSIBLE (Git will treat it as a command option)
- Remote visibility: YES (visible in git ls-remote)

This demonstrates the difference between Git's local and remote validation rules."

if ! echo "$readme_content" > README.md; then
    handle_error "Failed to write to README.md. Check file permissions."
fi
log_success "README.md updated with remote-only branch documentation"

# Show the change
log_info "README.md now contains:"
echo -e "${CYAN}$(cat README.md)${NC}"

# Add and commit changes
log_step "Staging and committing changes..."
if ! git add README.md; then
    handle_error "Failed to stage README.md changes"
fi

commit_message="Add remote-only branch documentation for: $branch_name"
if ! git commit -m "$commit_message"; then
    handle_error "Failed to commit changes"
fi
log_success "Changes committed with message: '$commit_message'"

# Push to create the remote branch using refspec
log_step "Creating remote branch '$branch_name' using refspec push..."
log_info "Using command: ${YELLOW}git push -u origin HEAD:$branch_name${NC}"

if ! git push -u origin "HEAD:$branch_name"; then
    handle_error "Failed to create remote branch using refspec. Check your network connection and repository permissions."
fi
log_success "Remote branch '$branch_name' created successfully using refspec!"

# Verify the branch exists remotely but cannot be checked out
log_step "Verifying branch characteristics..."

if git ls-remote --exit-code --heads origin "$branch_name" &>/dev/null; then
    log_success "✅ Branch exists on remote (confirmed)"
else
    log_error "❌ Branch not found on remote (unexpected)"
fi

# Test local checkout (should fail)
log_info "Testing local checkout (this should fail)..."
if git checkout "$branch_name" &>/dev/null; then
    log_warning "⚠️  Unexpectedly, local checkout succeeded! This branch might be valid locally."
    git checkout main &>/dev/null  # Switch back to main
else
    log_success "✅ Local checkout failed as expected (branch is truly invalid locally)"
fi

# Final success message
log_separator
log_success "🎉 Remote-only branch creation completed successfully!"
echo
log_info "Summary of actions performed:"
echo -e "  ${GREEN}•${NC} Created remote branch: ${CYAN}'$branch_name'${NC}"
echo -e "  ${GREEN}•${NC} Updated README.md with remote-only documentation"
echo -e "  ${GREEN}•${NC} Committed changes to main branch"
echo -e "  ${GREEN}•${NC} Pushed using refspec: ${YELLOW}HEAD:$branch_name${NC}"
echo
log_warning "IMPORTANT NOTES:"
echo -e "  ${YELLOW}•${NC} This branch exists ONLY on the remote"
echo -e "  ${YELLOW}•${NC} You CANNOT checkout this branch locally"
echo -e "  ${YELLOW}•${NC} You can see it with: ${CYAN}git ls-remote --heads origin${NC}"
echo -e "  ${YELLOW}•${NC} You can push to it with: ${CYAN}git push origin HEAD:$branch_name${NC}"
echo
log_info "Current branch: ${CYAN}'$(git branch --show-current)'${NC}"
log_separator